# Copy to .env.local and fill in.

# Required for the NL → SQL demo (/projects/nl-sql). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model chain, tried in order with retries and fallback (see lib/llm.ts for defaults).
GROQ_MODELS=

# NL → SQL demo (see README → "NL → SQL demo setup"). Without these the demo
# still generates SQL from the full schema, but does not retrieve or run it.
NLSQL_DATABASE_URL=
SUPABASE_URL=
NLSQL_EMBED_SECRET=
# Optional: Supabase CA certificate (PEM) to verify the database TLS certificate.
NLSQL_DATABASE_CA=

# Optional: shared rate limiting for the demo API across serverless instances.
# Without these, an in-memory limiter is used (per instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL for metadata, sitemap and robots (e.g. https://example.com).
# On Vercel the production domain is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# CX auto-evaluation pipeline (see pipelines/cx-eval/PLAN.md).
NVIDIA_API_KEY=

# Wikipedia Live. Keep credentials in .env.local, never in chat or Git.
# Aiven service Overview → Connection information (use the port for the chosen auth method).
KAFKA_BROKERS=
# Aiven CA: absolute path locally, mounted path in the container, or literal PEM.
KAFKA_CA=
# Certificate authentication (default Aiven connection method):
KAFKA_CERT=
KAFKA_KEY=
# Or enable SASL in Aiven and use its matching port and credentials instead:
KAFKA_USERNAME=
KAFKA_PASSWORD=

WIKISTREAM_USER_AGENT=PriyankPatilWikiStream/0.1 (https://github.com/priyankpatil/priyankpatil)
# Dedicated roles provisioned by wiki:db:apply. Never use the admin URL in the worker/site.
WIKISTREAM_DATABASE_URL=
WIKISTREAM_READ_URL=
# Optional trusted Supabase CA. PEM in the web deployment; PEM or path for workers.
WIKISTREAM_DATABASE_CA=
