# Copy to .env.local and fill in.

# Required for the NL → SQL demo (/projects/nl-sql). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Groq model chain, tried in order with retries and fallback (see lib/llm.ts for defaults).
GROQ_MODELS=

# NL → SQL demo (see README → "NL → SQL demo setup"). Without these the demo
# still generates SQL from the full schema, but does not retrieve or run it.
NLSQL_DATABASE_URL=
SUPABASE_URL=
NLSQL_EMBED_SECRET=
# Optional: Supabase CA certificate (PEM) to verify the database TLS certificate.
NLSQL_DATABASE_CA=

# Optional: shared rate limiting for the demo API across serverless instances.
# Without these, an in-memory limiter is used (per instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL for metadata, sitemap and robots (e.g. https://example.com).
# On Vercel the production domain is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

# CX auto-evaluation pipeline (see pipelines/cx-eval/PLAN.md).
NVIDIA_API_KEY=
