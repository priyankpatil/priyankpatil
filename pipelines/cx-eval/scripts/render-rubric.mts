// Renders pipelines/cx-eval/RUBRIC.md from RUBRIC_V1, so the human rubric and
// the judge prompt come from the same source.
//
//   npx tsx pipelines/cx-eval/scripts/render-rubric.mts

import { writeFileSync } from "fs";
import { dirname, join } from "path";
import { fileURLToPath } from "url";
import { FLOWS, FLOW_IDS } from "../src/contract.ts";
import { RUBRIC_V1 as r, actionButton, renderRubricPrompt, type Dimension } from "../src/rubric/v1.ts";

const out = join(dirname(fileURLToPath(import.meta.url)), "..", "RUBRIC.md");
const pct = (w: number) => `${Math.round(w * 100)}%`;
const cell = (s: string | number) => String(s).replace(/\|/g, "\\|");

// Show anchors as the judge sees them: action lines tagged with their button id.
const excerptLine = (line: string) => {
  const m = line.match(/^ACTION: (.*)$/);
  const id = m && actionButton(m[1]);
  return id ? `ACTION: [${id}] ${m[1]}` : line;
};

function dimension(d: Dimension, n: number): string {
  const lines = [`## ${n}. ${d.name} (\`${d.id}\`)`, "", `**Question:** ${d.question}`, ""];
  lines.push(`**Scale:** ${d.id === "intent" ? "one of the 10 flow ids above" : d.values.join(" / ")} · **Scored by:** ${d.scoredBy === "llm" ? "LLM judge (and you, for calibration)" : "code"}`, "");
  lines.push(`**Definition:** ${d.definition}`, "");
  if (d.levels) {
    lines.push("| Value | Meaning |", "|---|---|", ...d.levels.map((l) => `| ${cell(l.value)} | ${cell(l.meaning)} |`), "");
  }
  lines.push("**Decision rules** (in order):", "", ...d.rules.map((x, i) => `${i + 1}. ${x}`), "");
  lines.push("**Not applicable:**", "", ...d.na.map((x) => `- ${x}`), "");
  lines.push("**Common pitfalls:**", "", ...d.pitfalls.map((x) => `- ${x}`), "");
  if (d.anchors.length) {
    lines.push("**Anchors** (real ABCD conversations):", "");
    for (const a of d.anchors) {
      lines.push(`- **${a.label}**, convo \`${a.convoId}\` (${a.split}): ${a.why}`, "", "  ```", ...a.excerpt.map((l) => `  ${excerptLine(l)}`), "  ```", "");
    }
  }
  return lines.join("\n");
}

const w = r.cxiWeights;
const md = [
  `<!-- Generated by pipelines/cx-eval/scripts/render-rubric.mts from src/rubric/${r.version}.ts. Do not edit by hand. -->`,
  "",
  `# ${r.title} (${r.version})`,
  "",
  "The written rubric for the CX auto-evaluation pipeline. The LLM judge's prompt is generated from the same source (`src/rubric/v1.ts`), so what you read here is what the judge is told.",
  "",
  "## How to use it",
  "",
  "1. Read the transcript once end to end before scoring anything.",
  "2. Score each dimension below in order: check its not-applicable rules first, then apply its decision rules top to bottom.",
  "3. Write a short piece of evidence for each score: a quote or a reason, at most ~25 words.",
  "4. Use the anchors when unsure. They are real conversations whose labels have been checked against the ground-truth rules.",
  "",
  "General rules (also given to the judge):",
  "",
  ...r.general.map((g) => `- ${g}`),
  "",
  "## Scoring sheet",
  "",
  "Record one row per conversation. Efficiency is computed by the pipeline; copy it from the conversation record.",
  "",
  "| Field | Values |",
  "|---|---|",
  "| convo_id | from the dataset |",
  "| scorer, date | your name, today |",
  ...r.dimensions.map((d) => `| ${d.id} | ${d.id === "intent" ? "flow id" : cell(d.values.join(" / "))}${d.scoredBy === "code" ? " (computed)" : ""} |`),
  "| evidence | one short quote or reason per LLM dimension |",
  "| notes | anything ambiguous; it helps explain disagreements with the judge |",
  "",
  "## Flows (intent ids)",
  "",
  "| Flow | Description | Cues |",
  "|---|---|---|",
  ...FLOW_IDS.map((id) => `| \`${id}\` | ${FLOWS[id]} | ${cell(r.flowCues[id] ?? "")} |`),
  "",
  ...r.dimensions.map((d, i) => dimension(d, i + 1)),
  "## CXI (0–100)",
  "",
  `CXI = policy ${pct(w.policy_adherence)} + identity ${pct(w.identity_verification)} + resolution ${pct(w.resolution)} + empathy ${pct(w.empathy)} + efficiency ${pct(w.efficiency)}. Defined in code as \`cxiScore()\` in \`src/rubric/v1.ts\`; SQL marts are checked against it.`,
  "",
  "Each dimension is mapped to 0–100 first:",
  "",
  "| Dimension | Mapping |",
  "|---|---|",
  "| policy_adherence | pass = 100, fail = 0 |",
  "| identity_verification | pass = 100, fail = 0, na = excluded and the other weights renormalised |",
  "| resolution | resolved = 100, partial = 50, unresolved = 0 |",
  "| empathy | (score − 1) / 4 × 100 |",
  "| efficiency | (score − 1) / 4 × 100 |",
  "",
  `Example: an FAQ chat (identity na) that passes policy, is resolved, empathy 4, efficiency 5 scores (${w.policy_adherence}×100 + ${w.resolution}×100 + ${w.empathy}×75 + ${w.efficiency}×100) / ${(1 - w.identity_verification).toFixed(1)} = ${((w.policy_adherence * 100 + w.resolution * 100 + w.empathy * 75 + w.efficiency * 100) / (1 - w.identity_verification)).toFixed(1)}.`,
  "",
  "## The judge prompt",
  "",
  "The static part of the system prompt, rendered from this rubric. Per conversation, the logged contact reason, its policy steps and its guideline (truncated) are appended, and the transcript is sent as the user message.",
  "",
  "```text",
  renderRubricPrompt(),
  "```",
  "",
].join("\n");

writeFileSync(out, md);
console.log(`wrote ${out}`);
