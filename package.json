{
  "name": "priyankpatil-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "nl-sql:ingest": "tsx scripts/nl-sql-ingest.mts",
    "wiki:profile": "node --import tsx pipelines/wiki-stream/scripts/profile.mts",
    "wiki:topics": "node --import tsx pipelines/wiki-stream/scripts/setup.mts",
    "wiki:worker": "node --import tsx pipelines/wiki-stream/scripts/worker.mts",
    "wiki:health": "node --import tsx pipelines/wiki-stream/scripts/health.mts",
    "wiki:export-worker": "node --import tsx pipelines/wiki-stream/scripts/export-worker.mts",
    "wiki:verify": "node --import tsx pipelines/wiki-stream/scripts/verify.mts",
    "wiki:test": "node --import tsx --test pipelines/wiki-stream/tests/*.test.mts",
    "wiki:db:check": "node --import tsx pipelines/wiki-stream/scripts/bootstrap.mts",
    "wiki:db:apply": "node --import tsx pipelines/wiki-stream/scripts/bootstrap.mts --apply",
    "segments:load": "tsx pipelines/customer-segments/scripts/load.mts",
    "segments:setup": "python3 -m venv pipelines/customer-segments/.venv && pipelines/customer-segments/.venv/bin/pip install -r pipelines/customer-segments/model/requirements.txt",
    "segments:model": "pipelines/customer-segments/.venv/bin/python pipelines/customer-segments/model/model.py",
    "segments:export": "tsx pipelines/customer-segments/scripts/export.mts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.39",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.180",
    "framer-motion": "^11.15.0",
    "gray-matter": "^4.0.3",
    "kafkajs": "^2.2.4",
    "next": "^15.5.27",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "node-sql-parser": "^5.4.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reading-time": "^1.5.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "exceljs": "^4.4.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
